<!--
  Aggregator only - backend/ and frontend/ each build and test exactly as
  before, standalone, from their own directory (nothing here changes that).
  This just lets `mvn package -P deb` from the repo root build both .deb
  packages in one shot (01/09/2026) - see each module's own pom.xml for the
  packaging details, and docs/Design.md §13 for why the packages ship
  generic /var/lib defaults rather than any one server's real paths (real
  server specifics belong to each installation's own configuration, never
  to a tracked build file).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.myphotodiary</groupId>
	<artifactId>myphotodiary</artifactId>
	<version>2.10.4</version>
	<packaging>pom</packaging>

	<modules>
		<module>backend</module>
		<module>frontend</module>
	</modules>
</project>
