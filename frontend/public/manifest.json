{
  "id": "/",
  "name": "myPhotoDiary",
  "short_name": "myPhotoDiary",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#191919",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/legacy/mpd.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "/legacy/mpd-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/legacy/mpd-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-receive",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/gif",
            "image/heic",
            "image/heif",
            "video/mp4",
            "video/quicktime",
            ".jpg",
            ".jpeg",
            ".png",
            ".gif",
            ".webp",
            ".heic",
            ".mp4",
            ".mov"
          ]
        }
      ]
    }
  }
}
