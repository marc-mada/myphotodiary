# myphotodiary-backend configuration - read by systemd via EnvironmentFile
# (see myphotodiary-backend.service). This file is a dpkg conffile: your own
# edits survive a package upgrade (dpkg's standard conffile handling, same
# guarantee as e.g. /etc/ssh/sshd_config).
#
# The three paths below default to /var/lib/myphotodiary-backend/... so the
# service works immediately after `apt install` with no editing required
# beyond MPD_VIDEO_TOKEN_SECRET/MPD_SHARE_TOKEN_SECRET below (there's no
# safe default for a secret).
# If this server should instead use a specific disk/partition/mount point -
# e.g. because of its own capacity planning - change these three and make
# sure the target directories exist with the right ownership first:
#   sudo mkdir -p /your/chosen/path/{db,images,staging}
#   sudo chown -R myphotodiary:myphotodiary /your/chosen/path

# HSQLDB file-mode database path prefix (no .script extension).
MPD_DB_PATH=/var/lib/myphotodiary-backend/db/photoindex

# Gallery originals/thumbnails/web-derivatives root.
MPD_STORAGE_ROOT=/var/lib/myphotodiary-backend/images

# Staging-import root ("Batch Publish" in Admin -> Index management) - where
# not-yet-organized photos get dropped/mounted before import. A subdirectory
# of the main data path by default; point this at an actual external-disk
# mount point instead if that's how you plan to use the feature.
MPD_STAGING_ROOT=/var/lib/myphotodiary-backend/staging

# REQUIRED - no safe default for a secret. Signs short-lived video-streaming
# tokens (VideoStreamTokenService); a stable value here means a service
# restart doesn't invalidate every in-flight video stream token. Generate
# once, keep it:
#   openssl rand -hex 32
MPD_VIDEO_TOKEN_SECRET=

# REQUIRED - no safe default for a secret. Signs longer-lived (30-day)
# external share links for a single image or a whole sequence
# (ShareTokenService); a stable value here means a service restart doesn't
# invalidate every outstanding share link someone may still be using. A
# separate secret from MPD_VIDEO_TOKEN_SECRET on purpose - never reuse the
# same value for both, so leaking/rotating one never affects the other's
# forgery-resistance. Generate once, keep it:
#   openssl rand -hex 32
MPD_SHARE_TOKEN_SECRET=

# REQUIRED for link-preview og:image tags to work (25/09/2026,
# ShareLinkPreviewController - "the icon in WhatsApp/etc. isn't the actual
# photo") - the absolute scheme+host this server is publicly reachable at,
# e.g. https://myphotodiary.example.com (no trailing slash). Left unset,
# this falls back to reconstructing it from the request the web server
# forwards - correct only if nothing sits between the client and this
# service; behind a web server (the documented, recommended setup, Caddy)
# that fallback is usually wrong (typically reports plain http, the scheme
# the web server itself uses talking to this backend over loopback, not
# the https the public actually connects with) - set this explicitly
# whenever a web server is in front of this service.
MPD_PUBLIC_BASE_URL=

# Backup feature (18/09/2026) - see BackupProperties'/backup-images.sh's own
# comments for the full design. NOT enabled by a safe default the way the
# three paths above are: MPD_BACKUP_ROOT is unset here on purpose, and both
# the DB backup (inside this jar, nightly) and the image-tree backup
# (backup-images.sh, via myphotodiary-backend-backup.timer, daily) refuse to
# write anything until it points at a real, separately-mounted filesystem
# (a NAS share, ideally - a second local disk protects against less; same
# disk protects against even less than that, see BackupProperties' own
# javadoc) - so leaving this unset is safe (both sides just skip, visibly,
# rather than silently backing up nowhere useful), not a broken default.
#
# Once you have a backup target mounted (e.g. an NFS/CIFS share at
# /mnt/myphotodiary-backup - set that up via /etc/fstab first, with
# _netdev), point this at it:
#MPD_BACKUP_ROOT=/mnt/myphotodiary-backup
# How many days of daily snapshots to keep (both DB and image-tree) -
# older ones are pruned automatically after each successful new one.
MPD_BACKUP_RETENTION_DAYS=30
# Set to false only once you've made an informed decision to accept
# same-disk-only backups (or a second local disk, not the primary one) -
# see MPD_BACKUP_ROOT's own comment above for why the default is true.
MPD_BACKUP_REQUIRE_MOUNT=true
# Optional: name of a file that must exist in MPD_BACKUP_ROOT before any
# backup runs - create it once on the real backup target (e.g.
# `touch /mnt/nas-share/.myphotodiary-backup-target` while the NAS is
# mounted). An extra safety check on top of the mount check above.
#MPD_BACKUP_MARKER_FILE=.myphotodiary-backup-target
# Spring cron expression (6 fields) for the in-process DB backup.
MPD_DB_BACKUP_CRON=0 0 2 * * *
# Set to false to disable the DB backup entirely (e.g. if you'd rather rely
# on an external mechanism) - the image-tree timer is controlled separately,
# via `systemctl disable --now myphotodiary-backend-backup.timer`.
#MPD_BACKUP_ENABLED=true

# Only needed if ffmpeg/ffprobe aren't already on this service's own PATH
# (they're a package Depends:, so this is rarely needed) - full paths
# override the bare command name otherwise resolved from PATH.
#MPD_FFMPEG_PATH=/usr/bin/ffmpeg
#MPD_FFPROBE_PATH=/usr/bin/ffprobe

# Loopback port the embedded Tomcat listens on - the web server (Caddy) is
# expected to be the only thing actually reachable from outside;
# this service is never meant to bind a public interface directly.
SERVER_PORT=8090
